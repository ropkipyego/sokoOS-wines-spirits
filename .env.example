# =============================================================================
# SokoOS — environment template (copy to .env and fill values)
# =============================================================================

# --- API ---
NODE_ENV=development
PRODUCT_EDITION=WINES_SPIRITS
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:5174,http://localhost:5175

# --- PostgreSQL (Dedicated Wines & Spirits Local Dev DB) ---
DATABASE_URL=postgresql://sokoos:sokoos@127.0.0.1:5432/sokoos_wines_spirits?schema=public
POSTGRES_USER=sokoos
POSTGRES_PASSWORD=sokoos
POSTGRES_DB=sokoos_wines_spirits
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- SaaS hostnames (SaaS-01) ---
SOKOOS_BASE_DOMAIN=sokoos.com
SOKOOS_PLATFORM_HOST=platform.sokoos.com
SOKOOS_PUBLIC_HOSTS=

# --- JWT / Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- MinIO (optional object storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=sokoos
MINIO_ROOT_PASSWORD=sokoossecret
MINIO_BUCKET=sokoos
MINIO_USE_SSL=false
