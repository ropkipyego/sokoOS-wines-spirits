# =============================================================================
# SokoOS Wines & Spirits — Environment Template (copy to .env and fill values)
# =============================================================================

# --- Application & API ---
NODE_ENV=development
PRODUCT_EDITION=WINES_SPIRITS
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://127.0.0.1:5175,http://127.0.0.1:5174,http://localhost:5175,http://localhost:5174

# --- PostgreSQL (Dedicated Wines & Spirits DB) ---
DATABASE_URL=postgresql://sokoos:sokoos@127.0.0.1:5432/sokoos_wines_spirits?schema=public
POSTGRES_USER=sokoos
POSTGRES_PASSWORD=sokoos
POSTGRES_DB=sokoos_wines_spirits
POSTGRES_PORT=5432

# --- Redis (BullMQ Queues & Sync Fanout) ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# --- JWT / Auth (Must be cryptographically random >= 32 chars in production) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- MinIO / Object Storage (Optional) ---
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ROOT_USER=sokoos
MINIO_ROOT_PASSWORD=sokoossecret
MINIO_BUCKET=sokoos-wines
MINIO_USE_SSL=false
